raw `VerdanturfTown_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, VerdanturfTown_OnTransition
	.byte 0

VerdanturfTown_OnTransition:
	setflag FLAG_VISITED_VERDANTURF_TOWN
	setvar VAR_CONTEST_HALL_STATE, 0
	end

VerdanturfTown_EventScript_Twin::
	lock
	faceplayer
	goto_if_set FLAG_RUSTURF_TUNNEL_OPENED, VerdanturfTown_EventScript_TwinTunnelOpen
	msgbox VerdanturfTown_Text_ManTryingToDigTunnel, MSGBOX_DEFAULT
	applymovement LOCALID_VERDANTURF_TWIN, Common_Movement_FaceOriginalDirection
	waitmovement 0
	release
	end

VerdanturfTown_EventScript_TwinTunnelOpen::
	msgbox VerdanturfTown_Text_ManDugTunnelForLove, MSGBOX_DEFAULT
	applymovement LOCALID_VERDANTURF_TWIN, Common_Movement_FaceOriginalDirection
	waitmovement 0
	release
	end

VerdanturfTown_EventScript_Man::
	msgbox VerdanturfTown_Text_AirCleanHere, MSGBOX_NPC
	end

VerdanturfTown_EventScript_Camper::
	msgbox VerdanturfTown_Text_MakeBattleTentDebut, MSGBOX_NPC
	end

VerdanturfTown_EventScript_Boy::
	lock
	faceplayer
	goto_if_set FLAG_RUSTURF_TUNNEL_OPENED, VerdanturfTown_EventScript_BoyTunnelOpen
	msgbox VerdanturfTown_Text_GuyTryingToBustThroughCave, MSGBOX_DEFAULT
	release
	end

VerdanturfTown_EventScript_BoyTunnelOpen::
	msgbox VerdanturfTown_Text_EasyToGetToRustboroNow, MSGBOX_DEFAULT
	release
	end

VerdanturfTown_EventScript_TownSign::
	msgbox VerdanturfTown_Text_TownSign, MSGBOX_SIGN
	end

VerdanturfTown_EventScript_WandasHouseSign::
	msgbox VerdanturfTown_Text_WandasHouse, MSGBOX_SIGN
	end

VerdanturfTown_EventScript_BattleTentSign::
	msgbox VerdanturfTown_Text_BattleTentSign, MSGBOX_SIGN
	end

VerdanturfTown_EventScript_RusturfTunnelSign::
	msgbox VerdanturfTown_Text_RusturfTunnelSign, MSGBOX_SIGN
	end

VerdanturfTown_Text_ManTryingToDigTunnel:
	.string "My papa told me.\p"
	.string "He says this tunnel is full of\n"
	.string "timid POKéMON.\p"
	.string "They get all scared of loud noise and\n"
	.string "make a big uproar.\p"
	.string "So they had to stop the big tunnel\n"
	.string "project.\p"
	.string "But there's one man. He's trying to dig\n"
	.string "the tunnel by himself!$"

VerdanturfTown_Text_ManDugTunnelForLove:
	.string "There was a man who dug a tunnel for\n"
	.string "a lady he loved.\p"
	.string "I don't really get it, but hey!$"

VerdanturfTown_Text_AirCleanHere:
	.string "The way the winds blow, volcanic ash\n"
	.string "is never blown in this direction.\p"
	.string "The air is clean and delicious here.\n"
	.string "Living here should do wonders for even\l"
	.string "frail and sickly people.$"

VerdanturfTown_Text_MakeBattleTentDebut:
	.string "My POKéMON and I, we've been riding\n"
	.string "a hot winning streak.\p"
	.string "So I decided to make my BATTLE TENT\n"
	.string "debut in this town.$"

VerdanturfTown_Text_GuyTryingToBustThroughCave:
	.string "Did you see the cave next to the\n"
	.string "POKéMON MART?\p"
	.string "There's a guy in there who's trying to\n"
	.string "bust up boulders so he can bust out\l"
	.string "through to the other side.\p"
	.string "It'd be great if we could go through…\n"
	.string "It'll make it easy to visit RUSTBORO.$"

VerdanturfTown_Text_EasyToGetToRustboroNow:
	.string "That cave next to the POKéMON MART\n"
	.string "is now a tunnel to the other side.\p"
	.string "It's great--it's easy to go shop for\n"
	.string "new DEVON products in RUSTBORO now.$"

VerdanturfTown_Text_TownSign:
	.string "VERDANTURF TOWN\p"
	.string "“The windswept highlands with the\n"
	.string "sweet fragrance of grass.”$"

VerdanturfTown_Text_WandasHouse:
	.string "WANDA'S HOUSE$"

VerdanturfTown_Text_BattleTentSign:
	.string "BATTLE TENT VERDANTURF SITE\n"
	.string "“Feast Your Eyes on Battles!”$"

VerdanturfTown_Text_RusturfTunnelSign:
	.string "RUSTURF TUNNEL\n"
	.string "“Linking RUSTBORO and VERDANTURF\p"
	.string "“The tunnel project has been\n"
	.string "canceled.”$"

`

script VerdanturfTown_EventScript_Trigger1 {
    lockall
	addobject(6)
	addobject(5)
	addobject(7)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_VerdanturfTown_Trigger1)
	waitmovement
    call(VerdanturfTown_EventScript_ZinniaGrunt)
}

script VerdanturfTown_EventScript_Trigger2 {
    lockall
	addobject(6)
	addobject(5)
	addobject(7)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_VerdanturfTown_Trigger2)
	waitmovement
    call(VerdanturfTown_EventScript_ZinniaGrunt)
}

script VerdanturfTown_EventScript_Trigger3 {
    lockall
	addobject(6)
	addobject(5)
	addobject(7)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_VerdanturfTown_Trigger3)
	waitmovement
    call(VerdanturfTown_EventScript_ZinniaGrunt)
}

script VerdanturfTown_EventScript_Trigger4 {
    lockall
	addobject(6)
	addobject(5)
	addobject(7)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_VerdanturfTown_Trigger4)
	waitmovement
    call(VerdanturfTown_EventScript_ZinniaGrunt)
}

script VerdanturfTown_EventScript_Trigger5 {
    lockall
	addobject(6)
	addobject(5)
	addobject(7)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_VerdanturfTown_Trigger5)
	waitmovement
    call(VerdanturfTown_EventScript_ZinniaGrunt)
}

movement Movement_VerdanturfTown_Trigger1 {
    walk_down
    walk_left * 2
}

movement Movement_VerdanturfTown_Trigger2 {
    walk_left * 2
}

movement Movement_VerdanturfTown_Trigger3 {
    walk_up
    walk_left * 2
}

movement Movement_VerdanturfTown_Trigger4 {
    walk_up * 2
    walk_left * 2
}

movement Movement_VerdanturfTown_Trigger5 {
    walk_up * 3
    walk_left * 2
}

movement Movement_Verdanturf_Camera {
    walk_left * 3
}

movement Movement_Verdantuf_ResetCamera {
    walk_right * 3
}

script VerdanturfTown_EventScript_ZinniaGrunt {
    playbgm(MUS_ENCOUNTER_AQUA, FALSE)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Movement_Verdanturf_Camera)
    waitmovement
    applymovement(6, Movement_Verdanturf_Jump)
	playse(SE_LEDGE)
	waitse
	playse(SE_LEDGE)
    waitmovement
    msgbox(format("AQUA GRUNT: Lady! Your Whismur stole my stone!"))
    msgbox(format("???: My little Aster? She would never do such a thing!"))
    msgbox(format("AQUA GRUNT: Don't mess with TEAM AQUA! If I don't get that stone back..."))
    msgbox(format("???: Sounds like a you problem. And I don't like the way you called me 'lady' before..."))
    msgbox(format("AQUA GRUNT: What then, Mister?! Just gimme the--"))
    playse(SE_PIN)
    applymovement(6, Movement_MauvilleCity_Exclamation)
    waitmovement
    turnobject(6, DIR_EAST)
    msgbox(format("Hey, you! This is a private matter."))
	applymovement(5, Movement_VerdanturfTown_ZinniaEscape)
    applymovement(7, Movement_VerdanturfTown_WhismurEscape)
	msgbox(format("You better scram if you--"))
    waitmovement
	playse(SE_PIN)
    applymovement(6, Movement_MauvilleCity_Exclamation)
    waitmovement
    turnobject(6, DIR_WEST)
    delay(30)
    turnobject(6, DIR_NORTH)
    delay(30)
    turnobject(6, DIR_SOUTH)
    delay(30)
	turnobject(6, DIR_WEST)
    delay(30)
    turnobject(6, DIR_EAST)
    applymovement(OBJ_EVENT_ID_CAMERA, Movement_Verdantuf_ResetCamera)
    msgbox(format("AQUA GRUNT: YOU--!!!"))
	waitmovement
    special(RemoveCameraObject)
    trainerbattle_no_intro(TRAINER_AQUA_GRUNT_VERDANTURF, GruntVerdanturfPostBattle)
    msgbox(format("AQUA GRUNT: Tch, you get away this time, but when HOENN's underwater you'll wish you didn't cross TEAM AQUA."))
    applymovement(6, Movement_VerdanturfTown_AquaEscape)
    fadedefaultbgm
    waitmovement
    removeobject(6)
	call(VerdanturfTown_EventScript_ZinniaMeeting)
}

movement Movement_Verdanturf_Jump {
	jump_in_place_left
	jump_in_place_left
}

movement Movement_VerdanturfTown_ZinniaEscape {
	walk_fast_left * 5
    walk_fast_up *6
}

movement Movement_VerdanturfTown_WhismurEscape {
    walk_in_place_fast_right * 2
    walk_fast_left * 4
    walk_fast_up *6
}

movement Movement_VerdanturfTown_AquaEscape {
    walk_fast_right
    walk_fast_down
    walk_fast_right * 10
}

movement Movement_VerdanturfTown_ZinniaReturn {
	walk_down * 6
	walk_right * 8
}

movement Movement_VerdanturfTown_WhismurReturn {
	walk_in_place_down
	walk_down * 6
	walk_right * 7
}

text GruntVerdanturfPostBattle {
    "AQUA GRUNT: Archie's gonna\nkill me..."
}

script VerdanturfTown_EventScript_ZinniaMeeting {
	applymovement(7, Movement_VerdanturfTown_WhismurReturn)
	applymovement(5, Movement_VerdanturfTown_ZinniaReturn)
	waitmovement
	msgbox("???: Hey, you, thanks for distracting\nthat guy for me.\pYou didn't get hurt or anything?\pYou're pretty strong, you know.\nI saw you in Petalburg Woods.\pMy name is Zinnia. This is my\nsweet and adorable Whismur Aster.")
	applymovement(7, Movement_VerdanturfTown_WhismurEmote)
	playmoncry(SPECIES_WHISMUR, CRY_MODE_NORMAL)
	waitmoncry
	msgbox("ZINNIA: Actually, if you don't mind,\nI could use your help.\pThat stone he was talking about...\nI was looking for it in METEOR FALLS\lwhen TEAM AQUA got to it before me.\pCould you do me a favor and take it\nwith you?\pI need it at full power, and to get\nit there, it needs to be used.\pI have an extra armband, so if\nI just...")
	playse(SE_CLICK)
	msgbox("--CLICK--\pZINNIA: There we go. Here, I'm sure\nit'll come in handy for you.")
	giveitem(ITEM_MEGA_RING)
	msgbox("ZINNIA: This will let you unleash\nyour POKéMON's full potential.\pI hope you'll find it useful. I'll\nseek you out again in the near future.\pSo, until next time!")
	applymovement(5, Movement_VerdanturfTown_ZinniaLeave)
	applymovement(7, Movement_VerdanturfTown_WhismurLeave)
	playmoncry(SPECIES_WHISMUR, CRY_MODE_NORMAL)
	waitmovement
	removeobject(5)
	removeobject(7)
	setvar(VAR_ZINNIA_EVENTS, 3)
	releaseall
	end
}

movement Movement_VerdanturfTown_WhismurEmote {
	emote_heart
}

movement Movement_VerdanturfTown_ZinniaLeave {
	walk_down
	walk_right * 10
}

movement Movement_VerdanturfTown_WhismurLeave {
	walk_right
	walk_down
	walk_right * 10
}